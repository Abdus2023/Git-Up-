{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git-up.dev/schema/git-up.contract.v0.1.json",
  "title": "Git-Up! Implementation Contract",
  "description": "Derived JSON Schema for schema_version git-up.contract.v0.1. Not authoritative; the specification is.",
  "type": "object",
  "required": ["schema_version", "policy", "tasks"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "git-up.contract.v0.1"
    },
    "authority": {
      "type": "object",
      "description": "Optional contract-level sources (spec 09). Absent means none.",
      "properties": {
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/authority" }
        }
      }
    },
    "repository": {
      "type": "object",
      "description": "Optional bind. Absent means no repository expectation.",
      "properties": {
        "identity": { "type": "string" },
        "revision": { "type": "string" },
        "workspace": { "type": "string" },
        "dirty_state": {}
      }
    },
    "policy": {
      "type": "object",
      "required": ["failure_mode", "concurrency"],
      "properties": {
        "determinism": { "type": "boolean" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "concurrency": { "const": "exclusive" },
        "failure_mode": { "const": "fail_closed" }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "available": { "type": "boolean" },
          "binary": { "type": "string" },
          "version": { "type": "string" },
          "evidence": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "specification_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["task_id"],
              "properties": {
                "task_id": { "type": "string" },
                "obligations": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "scope": { "type": "string" },
          "priority": { "type": "integer" },
          "order": { "type": "integer" },
          "source_authority": {
            "type": "array",
            "items": { "$ref": "#/$defs/authority" }
          },
          "requirement_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "specification_refs": {
            "type": "array",
            "items": { "$ref": "#/$defs/authority" }
          },
          "implementation_targets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "prohibited_scope": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ref"],
              "properties": {
                "ref": { "type": "string" },
                "required_state": { "type": "string", "default": "PASS" }
              }
            }
          },
          "required_tools": {
            "type": "array",
            "items": { "type": "string" }
          },
          "allowed_tools": {
            "type": "array",
            "items": { "type": "string" }
          },
          "validation_commands": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "command"],
              "properties": {
                "id": { "type": "string" },
                "command": {
                  "description": "argv-or-string (spec 05). A list is canonicalized with shlex.join at load.",
                  "oneOf": [
                    { "type": "string", "minLength": 1 },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string", "minLength": 1 }
                    }
                  ]
                },
                "expected_exit": { "type": "integer", "default": 0 },
                "purpose": { "type": "string" }
              }
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "statement"],
              "properties": {
                "id": { "type": "string" },
                "statement": { "type": "string" },
                "validator": { "type": "string" }
              }
            }
          },
          "expected_outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
              }
            }
          },
          "declared_blockers": { "type": "array" },
          "spec_conflicts": { "type": "array" },
          "spec_gaps": { "type": "array" },
          "rejected": { "type": "boolean" },
          "deferred": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "anchor": { "type": "string" },
        "requirement_id": { "type": "string" }
      }
    }
  }
}
